{
  "name": "Search Devices",
  "description": "Search Armis devices using an ASQ query",
  "docker_parameters": "search-armis-devices",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "aql_query": {
        "description": "Armis ASQ query (e.g. ip:\"1.2.3.4\" or category:\"IP Camera\")",
        "type": "string"
      },
      "max_results": {
        "description": "Maximum number of results to return",
        "type": "integer",
        "default": 100
      }
    },
    "required": ["aql_query"]
  },
  "results": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "devices": {
        "type": "array",
        "items": { "type": "object" }
      },
      "total": {
        "type": "integer"
      }
    }
  }
}
