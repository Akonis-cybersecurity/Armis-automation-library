{
  "uuid": "61e923ed-b4b5-426f-969c-e29e37880cce",
  "name": "On New Armis Alert",
  "description": "Trigger a playbook run whenever a new Armis alert is detected",
  "docker_parameters": "on-new-armis-alert",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "intake_key": {
        "description": "Sekoia intake key",
        "type": "string",
        "secret": true
      },
      "polling_interval": {
        "description": "Polling interval in minutes",
        "type": "integer",
        "default": 2
      },
      "min_severity": {
        "description": "Minimum alert severity to trigger on: Low, Medium, High, Critical",
        "type": "string",
        "default": "High"
      }
    },
    "required": ["intake_key"]
  },
  "results": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "alertId": { "type": "integer" },
      "title": { "type": "string" },
      "severity": { "type": "string" },
      "status": { "type": "string" },
      "time": { "type": "string" },
      "type": { "type": "string" },
      "deviceIds": { "type": "array", "items": { "type": "integer" } }
    }
  }
}
